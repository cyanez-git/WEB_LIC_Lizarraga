    "CrisisdePareja.html": {
      "settings": {
        "meta_descr": "Criris de Pareja, buscando una solución",
        "title": "Crisis de Pareja",
        "order": 2
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
