---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Encuadre en celulares, donde la imagen se muestra apaisada. */
  encuadre?: string;
  /** Si es true, en celulares no se muestra. */
  soloEscritorio?: boolean;
}
const { src, encuadre = '50% 50%', soloEscritorio = false } = Astro.props;
---
<div class:list={['page-hero__media', { 'page-hero__media--solo-escritorio': soloEscritorio }]} style={`--encuadre: ${encuadre}`}>
  <Picture
    src={src}
    alt=""
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 760, 1122]}
    sizes="(max-width: 899px) calc(100vw - 40px), 380px"
    loading={soloEscritorio ? 'lazy' : 'eager'}
  />
</div>
