---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Encuadre en celulares, donde la imagen se muestra apaisada. */
  encuadre?: string;
}
const { src, encuadre = '50% 50%' } = Astro.props;
---
<div class="page-hero__media" style={`--encuadre: ${encuadre}`}>
  <Picture
    src={src}
    alt=""
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 760, 1122]}
    sizes="(max-width: 899px) calc(100vw - 40px), 380px"
    loading="eager"
  />
</div>
