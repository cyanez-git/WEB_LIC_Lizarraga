---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE, WHATSAPP_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.jpg', SITE.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.tagline.replaceAll(' · ', ', '),
  url: SITE.url,
  telephone: `+${SITE.whatsappNumber}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Buenos Aires' },
  hasCredential: [
    ...SITE.matriculas.map((m) => ({
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Matrícula profesional',
      name: `Licenciada en Psicología — ${m}`,
    })),
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Acreditación profesional',
      name: 'Sexóloga Clínica acreditada por la Asociación Internacional de Sexología Médica (AISM)',
      recognizedBy: { '@type': 'Organization', name: 'Asociación Internacional de Sexología Médica (AISM)' },
    },
  ],
  workLocation: [
    { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Barrio Norte', addressRegion: 'Ciudad Autónoma de Buenos Aires', addressCountry: 'AR' } },
    { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'San Isidro', addressRegion: 'Provincia de Buenos Aires', addressCountry: 'AR' } },
  ],
  sameAs: SITE.redes.map((r) => r.href),
  knowsAbout: ['Psicoterapia individual', 'Terapia de pareja', 'Sexología clínica', 'Terapia sexual'],
  contactPoint: { '@type': 'ContactPoint', contactType: 'WhatsApp', url: WHATSAPP_URL },
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FBF8F3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <ConsentBanner />
  </body>
</html>
