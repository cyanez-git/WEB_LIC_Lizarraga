# ==========================================================================
# sexualidad-activa.com — configuración Apache (cPanel / Atlantica Digital)
# Este archivo va en la raíz de public_html junto con el resto del sitio.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://sexualidad-activa.com%{REQUEST_URI} [L,R=301]

  # www -> sin www
  RewriteCond %{HTTP_HOST} ^www\.sexualidad-activa\.com$ [NC]
  RewriteRule ^ https://sexualidad-activa.com%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------------
  # Redirecciones de URLs del sitio anterior (Mobirise).
  # Completar con el inventario de páginas indexadas antes de publicar.
  # Formato: RewriteRule ^pagina-vieja\.html$ /pagina-nueva/ [L,R=301]
  # ------------------------------------------------------------------------
  # RewriteRule ^index\.php$ / [L,R=301]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Caché: imágenes, fuentes, CSS y JS 30 días (los de /_astro/ cambian de nombre en cada versión).
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
